{
  "name": "mini-agent",
  "version": "1.0.0",
  "description": "A mini coding agent CLI that implements the open Agent Skills specification.",
  "type": "module",
  "bin": {
    "mini-agent": "./bin/mini-agent.js"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "start": "node bin/mini-agent.js",
    "test": "node --test \"test/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "eval": "node scripts/trigger-eval.ts",
    "preview": "node scripts/preview.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "dotenv": "^17.4.2",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "typescript": "^7.0.2"
  },
  "license": "MIT",
  "private": true
}
